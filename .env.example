# Google AI Studio에서 발급받은 키를 입력합니다.
# 브라우저 코드나 NEXT_PUBLIC_ 환경 변수에는 넣지 마세요.
GEMINI_API_KEY=

# Tavily Dashboard에서 발급받은 서버 전용 키입니다.
# 실시간 웹 검색에 사용하며 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
TAVILY_API_KEY=

# Supabase Dashboard의 Connect 화면에서 확인합니다.
# Publishable key는 브라우저 사용을 전제로 한 공개 키입니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
